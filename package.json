{
  "name": "fire-isle",
  "version": "0.1.0",
  "private": true,
  "description": "Fire Isle — a 3D mobile multiplayer adaptation of the 1986 Fireball Island board game",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "server": "node --experimental-strip-types server/server.ts",
    "start": "npm run build && node --experimental-strip-types server/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cap:init": "npx cap init \"Fire Isle\" com.fireisle.app --web-dir dist",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/cli": "^6.2.0"
  }
}
